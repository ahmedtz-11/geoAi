# Copy to /srv/geoai/.env, fill in, then: chmod 600 /srv/geoai/.env
# Generate the secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GEOAI_SECRET_KEY=PUT_A_LONG_RANDOM_STRING_HERE
GEOAI_HTTPS=1
GEOAI_DATA=/srv/geoai/data
GEOAI_DATABASE_URL=sqlite:////srv/geoai/data/portal.db
GEOAI_USAGE_DB=/srv/geoai/data/portal.db
GEOAI_PORTAL_URL=https://geoai.example.com
GEOAI_BRAND=GeoAI
GEOAI_SUPPORT_EMAIL=support@example.com
GEOAI_CURRENCY=TZS
GEOAI_MAX_UPLOAD_MB=200
GEOAI_KEEP_RUNS=5          # finished runs kept per section, per person

# Payments: leave as manual until the client's merchant account and API keys exist.
GEOAI_PAYMENT_PROVIDER=manual
GEOAI_PAYMENT_WEBHOOK_SECRET=
