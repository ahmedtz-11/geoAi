[Unit]
Description=GeoAI Streamlit app
After=network.target

[Service]
User=geoai
Group=geoai
WorkingDirectory=/srv/geoai
EnvironmentFile=/srv/geoai/.env
# 127.0.0.1 only: the one way in is through nginx, which checks the gate first.
ExecStart=/srv/geoai/venv/bin/streamlit run app.py \
  --server.address 127.0.0.1 \
  --server.port 8501 \
  --server.baseUrlPath /app \
  --server.headless true \
  --server.enableCORS false \
  --server.enableXsrfProtection true \
  --server.maxUploadSize 200 \
  --browser.gatherUsageStats false
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/geoai/data

[Install]
WantedBy=multi-user.target
