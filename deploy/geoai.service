[Unit]
Description=GeoAI (site, accounts, admin dashboard and workbench)
After=network.target

[Service]
User=geoai
Group=geoai
WorkingDirectory=/srv/geoai
EnvironmentFile=/srv/geoai/.env
# One worker with threads, not several processes. A run's results are held in that process until it
# saves them, and background jobs live in it too, so a second process would not see them. Threads
# give the concurrency a handful of geologists need; see "More than a handful of people" in the
# README before changing this.
ExecStart=/srv/geoai/venv/bin/gunicorn \
  --workers 1 --threads 8 --worker-class gthread \
  --bind 127.0.0.1:8000 --timeout 600 --graceful-timeout 60 \
  wsgi:app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/geoai/data

[Install]
WantedBy=multi-user.target
